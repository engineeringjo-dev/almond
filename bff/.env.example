# BFF server config — SECRETS LIVE HERE, never in any client bundle.
PORT=8080
# 'memory' = runnable in-memory adapter (default). 'odoo' = real Odoo 19 (TODO).
DATA_SOURCE=memory

# NODE_ENV=production makes the server REFUSE TO BOOT on any of the development
# secrets below (see insecureBootReasons() in src/config.ts).
NODE_ENV=development

# Member auth (JWT). Production requires >= 32 characters and not this value.
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret
JWT_TTL=30d

# Short-lived signed POS scan token. It REPLACED the static replayable QR on
# 2026-09-08 — almond-app now fetches every barcode from POST /v1/pos/token and
# can no longer build one (see packages/shared/src/pos/tokenWire.ts).
POS_TOKEN_SECRET=change-me-too
# Optional. Unset, the TTL is config.POS_TOKEN_TTL_SECONDS from
# packages/shared/src/config — the one number the BFF mints with and the app's
# mock reports. Setting it here wins, and needs no app release: the phone reads
# the lifetime off each response (`expiresIn`), never off its own constant.
# Below ~10s the phone's polling floor bites and the member sees a brief
# "code expired" panel between codes (almond-app/lib/posQr.ts).
POS_TOKEN_TTL_SECONDS=60

# Shared key the till presents on /v1/pos/scan as `x-pos-key`. REQUIRED: the
# endpoint fails closed, so leaving this empty disables it rather than opening
# it — which is what the old `if (POS_SCAN_KEY && ...)` guard did instead.
POS_SCAN_KEY=

# Shared key the BACK OFFICE presents as `x-admin-key`. REQUIRED in production:
# the server refuses to boot without it (insecureBootReasons), and the guard —
# like /v1/pos/scan's — fails closed, so an empty value is a locked door rather
# than an open one.
#
# It gates the corporate register (who pays half price) AND the analytics export
# (/v1/analytics/order-lines, which carries other members' order history and was
# guarded by a plain member token until 2026-09-09).
#
# 🔴 It belongs on a SERVER. almond-web holds it as ADMIN_KEY inside its
# src/app/api/admin/* route handlers; the browser calls those, they call us.
ADMIN_KEY=

# Phone verification. There is deliberately NO fixed code: `OTP_DEV_CODE=123456`
# used to live here and verified EVERY account, whether or not a code had been
# requested. Until an SMS provider is wired, development reads the generated
# code from the server log. See docs/LOYALTY-ODOO-ARCHITECTURE.md §G gate 0.
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_SENDS_PER_HOUR=5

# Comma-separated allowed web/app origins (CORS). '*' for dev only.
CORS_ORIGINS=*

# Odoo 19 / loyalty server — only used when DATA_SOURCE=odoo (server-side only).
ODOO_BASE_URL=
ODOO_API_KEY=
LOYALTY_BASE_URL=
LOYALTY_TOKEN=
