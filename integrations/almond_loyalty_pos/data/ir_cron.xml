<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sends queued earn/reverse calls. The sale transaction also calls
             ir.cron._trigger() on this job, so an earn normally goes out within
             seconds; the 5-minute interval is the safety net for retries. -->
        <record id="ir_cron_almond_loyalty_outbox" model="ir.cron">
            <field name="name">Almond Loyalty: send earn/reverse outbox</field>
            <field name="model_id" ref="model_almond_loyalty_outbox"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_outbox(limit=100)</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
