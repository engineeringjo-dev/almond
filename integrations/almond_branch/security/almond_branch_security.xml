<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Odoo 19: category_id was removed from res.groups; groups are categorised
         via a res.groups.privilege record (privilege_id). -->
    <record id="privilege_almond_branch" model="res.groups.privilege">
        <field name="name">Almond Branch</field>
        <field name="category_id" ref="base.module_category_sales_point_of_sale"/>
    </record>

    <record id="group_almond_branch_manager" model="res.groups">
        <field name="name">Branch Manager</field>
        <field name="privilege_id" ref="privilege_almond_branch"/>
        <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_manager'))]"/>
        <field name="comment">Can create and edit branches and assign POS shops.</field>
    </record>

    <!-- Multi-company: a user only sees branches of companies they are in.
         Global rule (no groups) -> intersected with everything, applies to all. -->
    <record id="almond_branch_company_rule" model="ir.rule">
        <field name="name">Almond Branch: multi-company</field>
        <field name="model_id" ref="model_almond_branch"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

</odoo>
