<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add the Branch field to the POS config form.
         xpath targets the config name field, which is present on the pos.config form.
         VERIFY the anchor on dev-almond during /odoo-review; adjust the xpath if the
         v19 form structure differs. -->
    <record id="pos_config_view_form_inherit_branch" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.almond.branch</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="branch_id"
                       options="{'no_create_edit': True}"
                       placeholder="Assign a branch"/>
            </field>
        </field>
    </record>

</odoo>
