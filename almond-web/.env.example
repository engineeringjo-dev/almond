# almond-web environment. Copy to `.env.local` (gitignored) and fill real values.

# Data source: 'mock' (default, fully demoable) or 'odoo' (live). Public — safe
# to inline into the client bundle.
NEXT_PUBLIC_DATA_SOURCE=mock

# ── Ishbek delivery (Careem / Talabat) — SERVER-ONLY, never NEXT_PUBLIC_* ──
# Read only inside src/app/api/delivery/* route handlers, so the secret is never
# shipped to the browser. Required when NEXT_PUBLIC_DATA_SOURCE=odoo.
ISHBEK_KEY=
# HMAC secret used to verify inbound Ishbek status webhooks.
ISHBEK_WEBHOOK_SECRET=
