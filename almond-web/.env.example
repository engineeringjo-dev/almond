# almond-web environment. Copy to `.env.local` (gitignored) and fill real values.

# Data source: 'mock' (default, fully demoable) or 'odoo' (live). Public — safe
# to inline into the client bundle.
NEXT_PUBLIC_DATA_SOURCE=mock

# ── Ishbek delivery (Careem / Talabat) — SERVER-ONLY, never NEXT_PUBLIC_* ──
# Read only inside src/app/api/delivery/* route handlers, so the secret is never
# shipped to the browser. Required when NEXT_PUBLIC_DATA_SOURCE=odoo.
ISHBEK_KEY=
# HMAC secret used to verify inbound Ishbek status webhooks.
ISHBEK_WEBHOOK_SECRET=

# ── Back office (/admin) — SERVER-ONLY, never NEXT_PUBLIC_* ──────────────────
# The old gate used NEXT_PUBLIC_ADMIN_PASS, which Next inlines into the BROWSER
# bundle: the password shipped to every visitor, and its default was the literal
# 'almond'. These three replace it and must never gain that prefix.
#
# What a person types at /admin. Unset ⇒ the login refuses everything and says so.
ADMIN_PASSWORD=
# The BFF's admin credential (bff/src/plugins/adminAuth.ts). Held only by our
# route handlers under src/app/api/admin/*; the browser calls them, they call
# the BFF. A key in the browser is a key in every browser that opened the page.
ADMIN_KEY=
# Signs the admin session cookie. Unset ⇒ a random value per boot, so sessions
# simply do not survive a restart — an inconvenience, never a fixed default
# anyone could read out of the repo and use to mint a session.
ADMIN_SESSION_SECRET=
# Where the BFF lives. Unset ⇒ the back office says it has no server to talk to
# rather than failing with an opaque network error.
BFF_BASE_URL=
