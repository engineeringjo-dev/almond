  "narrative": {
    "northStar": "Daylight Counter",
    "overview": "Almond feels like a clear café counter: paper, ink, the real Almond badge and recognizable products. The existing Helvetica Neue Arabic family carries both languages. White photograph grounds are part of the owned imagery; the interface gives the product room rather than adding decorative artwork.\n\nThe owner selected this world on 2026-10-16. This record captures the accepted Home, Rewards, Order, Item sheet and Pay implementation. Component tokens above describe the light appearance; the role mapping below supplies dark appearance. Code remains the source of truth: [shared theme](../packages/shared/src/theme/index.ts), [app theme entrypoint](constants/theme.ts), [approved brief](docs/daylight-counter-brief.md). Review evidence and limits are in [validation](docs/daylight-counter-validation.md).",
    "keyCharacteristics": [
      "Neutral ordering and navigation, with one warm reward hue.",
      "Product photographs lead; clear bilingual type explains the action.",
      "Compact groups, separated tasks and touch targets that survive narrow widths."
    ],
    "rules": [
      {
        "name": "The Reward Scope Rule",
        "body": "Warmth marks points worth, cashback/earn-rate context and redemption emphasis. Ordering controls, prices and navigation stay ink.",
        "section": "colors"
      },
      {
        "name": "The Surface Pair Rule",
        "body": "Use `onInk` on ink fills, `onHero`/`onHeroMuted` on hero cards and `onReward` on reward fills. Never substitute literal white for a scheme-aware foreground. Appearance is selected at launch from the system setting, through the app theme entrypoint.",
        "section": "colors"
      },
      {
        "name": "The Bilingual Line Rule",
        "body": "Keep the implemented line heights, natural wrapping and Latin digits. Text chooses its own writing direction while alignment follows the interface reading start. Preserve tabular numerals on balances and amount choices. Do not compress Arabic ascenders to fit a fixed line.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do reuse the shared palette through `constants/theme.ts`, with the correct foreground/surface pair.",
      "Do keep ordering and navigation neutral while making real reward value warm.",
      "Do preserve the real logo, bundled bilingual fonts and existing product photographs.",
      "Do preserve readable wrapping, full touch targets, modifier choices and the server-issued scan code."
    ],
    "donts": [
      "Don't treat the legacy `gold`/`lightGold` names as permission to color prices or ordering controls gold.",
      "Don't add decorative artwork, extra brand hues or new entrance motion to this approved direction.",
      "Don't replace shared pricing, points or redemption rules with presentation-layer calculations.",
      "Don't treat sidecar preview snippets or synthesized tonal ramps as new app components or palette tokens."
    ]
  }
