  "components": [
    {
      "name": "Buttons",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The four existing Button variants in light appearance. Hover uses the pressed-opacity preview; the focus outline is panel-only.",
      "html": "<div class=\"ds-buttons\"><button class=\"ds-button ds-primary\">Add to basket</button><button class=\"ds-button ds-secondary\">Secondary</button><button class=\"ds-button ds-outline\">Outline</button><button class=\"ds-button ds-ghost\">Ghost</button></div>",
      "css": ".ds-buttons{display:flex;flex-wrap:wrap;gap:8px}.ds-button{font-family:'HelveticaNeueArabic-Bold','Helvetica Neue',Arial,sans-serif;font-size:16px;line-height:24px;font-weight:700;min-height:52px;padding:12px 24px;border-radius:12px;border:0;cursor:pointer}.ds-primary{background:#111111;color:#FFFFFF}.ds-secondary{background:#FFFFFF;color:#111111;border:1.5px solid #111111}.ds-outline{background:transparent;color:#111111;border:1.5px solid #111111}.ds-ghost{background:transparent;color:#111111}.ds-button:hover:not(:disabled),.ds-button:active:not(:disabled){opacity:.85}.ds-button:focus-visible{outline:2px solid #111111;outline-offset:2px}.ds-button:disabled{opacity:.45;cursor:default}"
    },
    {
      "name": "Search field",
      "kind": "input",
      "refersTo": "search",
      "description": "Empty SearchBar: control ground, visible edge, muted placeholder and existing line-icon language. The preview input is editable.",
      "html": "<label class=\"ds-search\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><input class=\"ds-search-input\" aria-label=\"Search the menu\" placeholder=\"Search the menu\" type=\"search\"/></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:8px;height:48px;padding:0 16px;background:#F4F4F2;border:1px solid #8A8A85;border-radius:999px;color:#5C5C58}.ds-search .ds-icon{width:18px;height:18px;flex-shrink:0}.ds-search-input{font-family:'HelveticaNeueArabic-Roman','Helvetica Neue',Arial,sans-serif;flex:1;min-width:0;align-self:stretch;border:0;background:transparent;color:#111111;font-size:16px}.ds-search-input::placeholder{color:#5C5C58;opacity:1}.ds-search:hover{border-color:#8A8A85}.ds-search-input:focus-visible{outline:2px solid #111111;outline-offset:2px}"
    },
    {
      "name": "Category navigation",
      "kind": "chip",
      "refersTo": "category-chip",
      "description": "Current category uses neutral ink; resting categories retain the page ground and outline. Category controls navigate within one menu.",
      "html": "<nav class=\"ds-categories\" aria-label=\"Menu categories\"><button class=\"ds-category\" aria-current=\"true\">Coffee</button><button class=\"ds-category\">Bakery</button><button class=\"ds-category\">Cold drinks</button></nav>",
      "css": ".ds-categories{display:flex;gap:8px;overflow:auto;padding:8px 16px}.ds-category{font-family:'HelveticaNeueArabic-Roman','Helvetica Neue',Arial,sans-serif;flex-shrink:0;min-height:44px;padding:8px 12px;border:1px solid #8A8A85;border-radius:999px;background:#FFFFFF;color:#111111;font-size:14px;line-height:20px;cursor:pointer}.ds-category[aria-current=true]{background:#111111;border-color:#111111;color:#FFFFFF}.ds-category:hover,.ds-category:active{opacity:.75}.ds-category:focus-visible{outline:2px solid #111111;outline-offset:2px}"
    },
    {
      "name": "Bottom navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Five neutral destinations with the raised barcode action. The preview shows the minimum web bottom inset; device safe areas remain runtime-dependent.",
      "html": "<nav class=\"ds-bottom-nav\" aria-label=\"Main navigation\"><button class=\"ds-tab ds-tab-current\" aria-current=\"page\"><span class=\"ds-tab-icon\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z\"/></svg></span><span>Home</span></button><button class=\"ds-tab\"><span class=\"ds-tab-icon\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M18 8h1a4 4 0 0 1 0 8h-1M3 8h15v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4zM6 1v3M10 1v3M14 1v3\"/></svg></span><span>Order</span></button><button class=\"ds-tab ds-code-tab\"><span class=\"ds-code-fab\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"5\" height=\"5\" rx=\"1\"/><rect x=\"16\" y=\"3\" width=\"5\" height=\"5\" rx=\"1\"/><rect x=\"3\" y=\"16\" width=\"5\" height=\"5\" rx=\"1\"/><path d=\"M16 16h2v2h3M16 21v-2M21 16v-3M11 3v5M3 11h5M11 11h5v2M11 16v5\"/></svg></span><span>Barcode</span></button><button class=\"ds-tab\"><span class=\"ds-tab-icon\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M10.3 3.3a9.5 9.5 0 0 1 10.4 10.4 9.5 9.5 0 0 1-10.4 7A9.5 9.5 0 0 1 3.3 10.3a9.5 9.5 0 0 1 7-7Z\"/><path d=\"M6 6c0 5 3 6 6 6s6 1 6 6\"/></svg></span><span>Rewards</span></button><button class=\"ds-tab\"><span class=\"ds-tab-icon\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 6h16M4 12h16M4 18h16\"/></svg></span><span>More</span></button></nav>",
      "css": ".ds-bottom-nav{display:flex;height:94px;padding:10px 0 16px;box-sizing:border-box;border-top:1px solid #EFEFEC;background:#FFFFFF}.ds-tab{font-family:'HelveticaNeueArabic-Bold','Helvetica Neue',Arial,sans-serif;position:relative;display:flex;flex:1;min-width:0;align-items:center;justify-content:flex-start;flex-direction:column;gap:2px;border:0;padding:0;background:transparent;color:#5C5C58;font-size:11px;line-height:16px;cursor:pointer}.ds-tab-icon{position:relative;display:flex;align-items:center;justify-content:center;width:30px;height:28px;margin-bottom:2px}.ds-tab .ds-icon{width:24px;height:24px}.ds-tab-current{color:#111111}.ds-tab-current .ds-icon{stroke-width:2.4}.ds-tab-current .ds-tab-icon::after{content:\"\";position:absolute;bottom:-5px;width:5px;height:5px;border-radius:3px;background:#111111}.ds-code-fab{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:56px;height:56px;margin-top:-24px;border:4px solid #FFFFFF;border-radius:28px;background:#111111;color:#FFFFFF;box-shadow:0 6px 16px rgba(0,0,0,.14)}.ds-code-fab .ds-icon{width:26px;height:26px;stroke-width:2.2}.ds-tab:hover,.ds-tab:active{opacity:.85}.ds-tab:focus-visible{outline:2px solid #111111;outline-offset:2px}"
    },
    {
      "name": "Membership card",
      "kind": "card",
